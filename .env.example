# ===== App =====
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
TZ=America/Sao_Paulo

# ===== Banco (PostgreSQL — recurso do Coolify) =====
DATABASE_URL=postgresql://usuario:senha@radioconnect-postgres:5432/radioconnect?schema=public

# ===== Redis (filas BullMQ e Estado No Ar — recurso do Coolify) =====
REDIS_URL=redis://default:senha@radioconnect-redis:6379

# ===== Autenticação =====
# Segredo para assinar os tokens de sessão do ouvinte e do operador (HMAC-SHA256).
JWT_SECRET=
# Validade do token do ouvinte. Longa de propósito: o cadastro é obrigatório uma vez só
# e nada é mais frustrante que ser deslogado de um app de rádio.
JWT_OUVINTE_EXPIRA=180d
JWT_OPERADOR_EXPIRA=12h

# Envio do código de verificação por telefone. Vazio = modo demo: o código é sempre
# 000000 e aparece no log. NUNCA deixar vazio em produção.
SMS_API_URL=
SMS_API_KEY=

# ===== Estado No Ar =====
# De quanto em quanto tempo o agendador reavalia a programação e recalcula o estado
# de cada emissora (segundos). Abaixo de 10 não melhora a percepção e só gasta CPU.
NO_AR_INTERVALO_SEGUNDOS=15
# Tempo que uma sessão de ouvinte conta como "presente" para o número de ouvintes
# vivendo o momento (segundos).
PRESENCA_TTL_SEGUNDOS=90

# ===== Anúncios =====
# Se a decisão de anúncio não responder neste tempo, o app desiste e abre a rádio.
# Nunca fazer o ouvinte esperar por publicidade que não veio.
AD_TIMEOUT_MS=2000
# Tag do Google Ad Manager para preenchimento programático. Vazio = só mídia direta.
GAM_NETWORK_CODE=
GAM_AD_UNIT_BANNER=

# ===== Chatwoot (uma instalação, um Account por emissora) =====
CHATWOOT_BASE_URL=
CHATWOOT_PLATFORM_TOKEN=

# ===== Push (Firebase Cloud Messaging) =====
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ===== Studio =====
# Origens de navegador autorizadas, separadas por vírgula.
# Inclui o app enquanto ele roda como web — compilado para as lojas, deixa de precisar.
STUDIO_ORIGINS=https://studio.radioconnect.technowhub.ai,https://app.radioconnect.technowhub.ai,http://localhost:3001,http://localhost:3002
