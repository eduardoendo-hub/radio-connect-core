{
  "name": "radio-connect-core",
  "version": "0.1.0",
  "private": true,
  "description": "Núcleo do Radio Connect — Estado No Ar, Momentos, decisão de anúncio, eventos e integração com o Chatwoot.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:dev": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed:demo": "tsx src/scripts/seed-demo.ts",
    "gerador:vida": "tsx src/scripts/gerador-de-vida.ts",
    "test": "tsx --test 'src/**/*.test.ts'",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "jose": "^6.2.8",
    "pino": "^9.5.0",
    "prisma": "^5.22.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "ioredis": "^5.4.2"
  }
}
